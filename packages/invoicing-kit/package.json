{
  "name": "invoicing-kit",
  "version": "0.9.0",
  "description": "Drop-in invoicing API for Hono + better-auth apps: clients, products, taxes, quotes, invoices, and payments.",
  "type": "module",
  "license": "MIT",
  "author": "Bitzer AI",
  "homepage": "https://github.com/Bitzer-AI/invoice-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitzer-AI/invoice-kit.git",
    "directory": "packages/invoicing-kit"
  },
  "bugs": {
    "url": "https://github.com/Bitzer-AI/invoice-kit/issues"
  },
  "keywords": [
    "invoicing",
    "invoice",
    "billing",
    "quotes",
    "payments",
    "hono",
    "better-auth",
    "prisma",
    "zod",
    "openapi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:copy": "bun run tests/fixtures/copy-templates.ts",
    "db:push": "bun run db:copy && prisma db push --schema tests/fixtures/prisma && prisma generate --schema tests/fixtures/prisma",
    "db:up": "docker compose -f ../../docker-compose.test.yml up -d",
    "db:down": "docker compose -f ../../docker-compose.test.yml down"
  },
  "prisma": {
    "schema": "tests/fixtures/prisma"
  },
  "peerDependencies": {
    "@hono/zod-openapi": "^1.0.0",
    "@prisma/client": ">=7.0.0",
    "better-auth": ">=1.4.0",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/client": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "better-auth": "^1.4.13",
    "hono": "^4.12.24",
    "prisma": "^7.2.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "zod": "^4.3.5"
  }
}
