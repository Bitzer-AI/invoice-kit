model Product {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  name           String   @map("name")
  description    String?  @map("description")
  price          Decimal  @map("price") @db.Decimal(10, 2)
  // ISO 4217 code (lowercase) the catalog price is denominated in. Line items
  // referencing this product must belong to a document in the same currency.
  currency       String   @default("usd") @db.VarChar(3)
  // Optional link to a host-app domain object this product mirrors (e.g. an
  // experience, course, or plan). `sourceType` is an opaque app-defined string;
  // `sourceId` is that object's id. Enables find-or-create from a line item.
  sourceType     String?  @map("source_type")
  sourceId       String?  @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    DocumentLineItem[]

  // At most one product per (org, sourceType, sourceId). Postgres treats NULLs
  // as distinct, so manual products (null source) are unconstrained.
  @@unique([organizationId, sourceType, sourceId])
  @@map("products")
}
