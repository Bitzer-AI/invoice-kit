enum DocumentType {
  QUOTE
  INVOICE
  VENDOR_BILL
}

enum InvoiceStatus {
  draft
  sent
  paid
  partially_paid
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  converted
}

enum VendorBillStatus {
  draft
  received
  partially_paid
  paid
}

enum TaxType {
  PERCENTAGE
  FIXED
}

model DocumentNumberSequence {
  id             String       @id @default(uuid(7))
  organizationId String       @map("organization_id")
  documentType   DocumentType
  prefix         String       @default("") @db.VarChar(20)
  label          String?      @db.VarChar(100)
  nextNumber     Int          @map("next_number")
  padWidth       Int?         @map("pad_width")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  @@unique([organizationId, documentType, prefix])
  @@map("document_number_sequences")
}

model Tax {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  type           TaxType  @default(PERCENTAGE)
  rate           Decimal  @db.Decimal(10, 4)
  isActive       Boolean  @default(true) @map("is_active")
  isDefault      Boolean  @default(false) @map("is_default")
  fiscalCategory String?  @map("fiscal_category")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItemTaxes DocumentLineItemTax[]

  @@index([organizationId, isActive])
  @@map("taxes")
}

model Vendor {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  name           String   @map("name")
  email          String?  @map("email")
  phone          String?  @map("phone")
  taxId          String?  @map("tax_id")
  taxIdType      String?  @map("tax_id_type")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  documents    Document[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("vendors")
}

model Document {
  id                     String       @id @default(uuid(7))
  type                   DocumentType
  organizationId         String       @map("organization_id")
  clientId               String?      @map("client_id")
  vendorId               String?      @map("vendor_id")
  externalDocumentNumber String?      @map("external_document_number") @db.VarChar(40)
  documentNumberPrefix   String?      @map("document_number_prefix") @db.VarChar(20)
  documentNumber         Int          @map("document_number")
  issueDate              DateTime     @map("issue_date") @db.Date
  dueDate                DateTime?    @map("due_date") @db.Date
  notes                  String?      @db.Text
  currency               String       @default("usd") @db.VarChar(3)
  subtotal               BigInt? // Amount in minor units (cents)
  tax                    BigInt? // Amount in minor units (cents)
  total                  BigInt? // Amount in minor units (cents)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vendor         Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quote          Quote?
  invoice        Invoice?
  vendorBill     VendorBill?
  lineItems      DocumentLineItem[]
  paymentMethods DocumentPaymentMethod[]

  @@unique([organizationId, type, documentNumber, documentNumberPrefix])
  @@index([documentNumber])
  @@index([organizationId, vendorId])
  @@map("documents")
}

model Quote {
  id         String      @id @default(uuid(7))
  documentId String      @unique @map("document_id")
  status     QuoteStatus
  validUntil DateTime?   @map("valid_until") @db.Date

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  convertedInvoice Invoice?

  @@map("quotes")
}

model Invoice {
  id                   String        @id @default(uuid(7))
  documentId           String        @unique @map("document_id")
  status               InvoiceStatus
  paidDate             DateTime?     @map("paid_date") @db.Date
  convertedFromQuoteId String?       @unique @map("converted_from_quote_id")

  convertedFromQuote Quote?          @relation(fields: [convertedFromQuoteId], references: [id], onDelete: SetNull)
  document           Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  payments           Payment[]
  fiscalDocument     FiscalDocument?

  @@map("invoices")
}

model VendorBill {
  id         String           @id @default(uuid(7))
  documentId String           @unique @map("document_id")
  status     VendorBillStatus

  document Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  payments VendorBillPayment[]

  @@map("vendor_bills")
}

model FiscalDocument {
  id            String    @id @default(uuid(7))
  invoiceId     String    @unique @map("invoice_id")
  provider      String
  status        String    @default("pending")
  documentType  String?   @map("document_type")
  fiscalId      String?   @map("fiscal_id")
  trackId       String?   @map("track_id")
  securityCode  String?   @map("security_code")
  qrUrl         String?   @map("qr_url")
  message       String?
  payload       Json?
  issuedAt      DateTime? @map("issued_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@map("fiscal_documents")
}

model DocumentLineItem {
  id          String   @id @default(uuid(7))
  documentId  String   @map("document_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(10, 4)
  price       BigInt // Unit price in minor units (cents)
  taxAmount   BigInt?  @default(0) @map("tax_amount") // Amount in minor units (cents)
  total       BigInt // Amount in minor units (cents)
  description String?  @map("description") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  document Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxes    DocumentLineItemTax[]

  @@map("document_line_items")
}

model DocumentLineItemTax {
  id         String   @id @default(uuid(7))
  lineItemId String   @map("line_item_id")
  taxId      String   @map("tax_id")
  taxAmount  BigInt   @map("tax_amount") // Amount in minor units (cents)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  lineItem DocumentLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  tax      Tax              @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@unique([lineItemId, taxId])
  @@map("document_line_item_taxes")
}

model VendorBillPayment {
  id              String                  @id @default(uuid(7))
  organizationId  String                  @map("organization_id")
  vendorBillId    String                  @map("vendor_bill_id")
  paymentMethodId String?                 @map("payment_method_id")
  amount          BigInt
  currency        String                  @default("usd") @db.VarChar(3)
  status          VendorBillPaymentStatus @default(succeeded)
  provider        String
  paidAt          DateTime?               @map("paid_at")
  reference       String?                 @db.VarChar(255)
  notes           String?                 @db.Text
  recordedBy      String?                 @map("recorded_by")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBill    VendorBill     @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([organizationId, vendorBillId])
  @@index([status])
  @@map("vendor_bill_payments")
}

enum VendorBillPaymentStatus {
  succeeded
  failed
  canceled
}
